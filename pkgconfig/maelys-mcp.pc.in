prefix=@PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: maelys-mcp
Description: Native policy-enforced MCP runtime and provider host
Version: @VERSION@
Requires.private: jansson liburiparser
Libs: -L${libdir} -lmaelys_mcp
Libs.private: -pthread
Cflags: -I${includedir}

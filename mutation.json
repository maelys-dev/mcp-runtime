{
  "config_version": 1,
  "language": "c",
  "include": [
    "src/**/*.c"
  ],
  "exclude": [
    "src/**/*.h"
  ],
  "operators": [
    "condition_kill",
    "relational_swap",
    "logical_swap",
    "constant_flip"
  ],
  "build_command": "make -j4 test-build",
  "kill_command": "make check",
  "build_timeout_seconds": 600,
  "timeout_seconds": 900,
  "scratch": {
    "strategy": "copy",
    "exclude": [".git", "build", "__pycache__", ".DS_Store", "dist", "stage"]
  }
}
